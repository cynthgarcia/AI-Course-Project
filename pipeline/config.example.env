# Copy to .env and fill in your values.
# Do not commit .env to git.

# LLM: OpenAI (used to generate the brief)
OPENAI_API_KEY=sk-...

# Email: where to send the brief (SMTP)
EMAIL_TO=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: use a different LLM (set to "anthropic" to use Claude)
# LLM_PROVIDER=openai
# For Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
