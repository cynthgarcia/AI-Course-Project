# Your Life Curator — server-side configuration.
# Copy to .env.local and fill in. Never commit real values.
# None of these are required: without them the app runs in demo mode.

# Database. Leave unset locally to use the embedded Postgres in .data/.
# DATABASE_URL=postgres://user:password@host:5432/db   # server only
# DATABASE_SSL=disable                                  # only for a local Postgres without TLS
# DATA_DIR=.data/pglite                                 # embedded database location
# COOKIE_INSECURE=1                                     # only when serving over plain http on a non-localhost host
# SIGNUP_RATE_LIMIT=10                                  # sign-ups per hour per IP

# Phase 3 — Google Calendar, read-only free/busy (not yet wired up)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=             # server only
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Event sources (server only). Sample events show until a real source is configured.
# TICKETMASTER_API_KEY=              # free: developer.ticketmaster.com
# TICKETMASTER_EUROPE=1              # 0 = London only
# EVENTBRITE_TOKEN=                  # your Eventbrite private token
# EVENTBRITE_ORGANIZER_IDS=          # comma-separated organiser IDs to follow
# DEMO_EVENTS=                       # 1 = always show sample events, 0 = never
